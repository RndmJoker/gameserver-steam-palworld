# ============================================================
# Palworld Dedicated Server – Configuration
# Official docs: https://docs.palworldgame.com/settings-and-operation/configuration/
# Copy this file to .env and customize:  cp .env.example .env
#
# All settings have safe defaults (defined in hooks/defaults.sh).
# You only need to change what you want to customize.
# Uncommented values below override the defaults.
# ============================================================

# ── Docker Infrastructure ───────────────────────────────────
# These control Docker port mapping and resource limits.
GAME_PORT=8211
RCON_PORT=25575
MEM_LIMIT=12g
# STEAM_LOGIN=anonymous
# SKIP_STEAM_UPDATE=false
# GAME_ARGS=

# ── Server Identity ─────────────────────────────────────────
ServerName=My Palworld Server
ServerDescription=
ServerPassword=
AdminPassword=changeme
ServerPlayerMaxNum=32
# PublicIP=
# Region=

# ── RCON and REST API ───────────────────────────────────────
RCONEnabled=False
# RESTAPIEnabled=False
# RESTAPIPort=8212

# ── Server Management ──────────────────────────────────────
# bUseAuth=True
# BanListURL=https://api.palworldgame.com/api/banlist.txt
# bIsUseBackupSaveData=True
# bIsShowJoinLeftMessage=True
# bAllowClientMod=False
# ChatPostLimitPerMinute=10
# LogFormatType=Text

# ── Performance ─────────────────────────────────────────────
# BaseCampMaxNumInGuild: Max bases per guild (max 10, increases load)
# BaseCampMaxNumInGuild=4
# BaseCampWorkerMaxNum: Max Pals per base (max 50, increases load)
# BaseCampWorkerMaxNum=15
# MaxBuildingLimitNum: Per-player building cap (0 = unlimited)
# MaxBuildingLimitNum=0
# ServerReplicatePawnCullDistance: Pal sync distance in cm (5000-15000)
# ServerReplicatePawnCullDistance=15000.000000

# ── Game Mode ───────────────────────────────────────────────
# Difficulty=None
# bIsMultiplay=False
# bIsPvP=False
# bHardcore=False
# bCharacterRecreateInHardcore=True

# ── Features ────────────────────────────────────────────────
# bEnablePlayerToPlayerDamage=False
# bEnableFriendlyFire=False
# bEnableInvaderEnemy: Enable raid events
# bEnableInvaderEnemy=True
# bActiveUNKO=False
# bEnableAimAssistPad=True
# bEnableAimAssistKeyboard=False
# bEnableNonLoginPenalty=True
# bEnableFastTravel=True
# bEnableFastTravelOnlyBaseCamp: Restrict fast travel to bases only
# bEnableFastTravelOnlyBaseCamp=False
# bIsStartLocationSelectByMap: Allow players to choose spawn location
# bIsStartLocationSelectByMap=True
# bExistPlayerAfterLogout: Players stay in world when logging out
# bExistPlayerAfterLogout=False
# bEnableDefenseOtherGuildPlayer=False
# bBuildAreaLimit: Prevent building near fast-travel points
# bBuildAreaLimit=False
# bInvisibleOtherGuildBaseCampAreaFX: Show base boundaries
# bInvisibleOtherGuildBaseCampAreaFX=False
# bShowPlayerList=True
# bCanPickupOtherGuildDeathPenaltyDrop=False
# bAutoResetGuildNoOnlinePlayers: Delete guild structures if no members online
# bAutoResetGuildNoOnlinePlayers=False
# AutoResetGuildTimeNoOnlinePlayers: Hours offline before guild reset (if enabled)
# AutoResetGuildTimeNoOnlinePlayers=72.000000

# ── Randomizer ──────────────────────────────────────────────
# RandomizerType: None / Region / All
# RandomizerType=None
# RandomizerSeed=0
# bIsRandomizerPalLevelRandom=False

# ── Stat Enhancement ────────────────────────────────────────
# bAllowEnhanceStat_Attack=True
# bAllowEnhanceStat_Health=True
# bAllowEnhanceStat_Stamina=True
# bAllowEnhanceStat_Weight=True
# bAllowEnhanceStat_WorkSpeed=True

# ── Global Palbox ───────────────────────────────────────────
# bAllowGlobalPalboxExport=False
# bAllowGlobalPalboxImport=False

# ── PvP Settings ────────────────────────────────────────────
# bAdditionalDropItemWhenPlayerKillingInPvPMode=False
# AdditionalDropItemNumWhenPlayerKillingInPvPMode=0
# bDisplayPvPItemNumOnWorldMap_BaseCamp=False
# bDisplayPvPItemNumOnWorldMap_Player=False

# ── Items and Drops ─────────────────────────────────────────
# DropItemMaxNum=3000
# DropItemMaxNum_UNKO=100
# DropItemAliveMaxHours=1.000000

# ── Limits ──────────────────────────────────────────────────
# BaseCampMaxNum=128
# CoopPlayerMaxNum=4
# GuildPlayerMaxNum=20
# GuildRejoinCooldownMinutes=0

# ── Game Balance – Speed and Rates ──────────────────────────
# DayTimeSpeedRate=1.000000
# NightTimeSpeedRate=1.000000
# ExpRate=1.000000
# PalCaptureRate=1.000000
# PalSpawnNumRate: Pal spawn rate (affects performance)
# PalSpawnNumRate=1.000000
# WorkSpeedRate=1.000000

# ── Game Balance – Player Stats ─────────────────────────────
# PlayerDamageRateAttack=1.000000
# PlayerDamageRateDefense=1.000000
# PlayerStomachDecreaceRate=1.000000
# PlayerStaminaDecreaceRate=1.000000
# PlayerAutoHPRegeneRate=1.000000
# PlayerAutoHpRegeneRateInSleep=1.000000

# ── Game Balance – Pal Stats ────────────────────────────────
# PalDamageRateAttack=1.000000
# PalDamageRateDefense=1.000000
# PalStomachDecreaceRate=1.000000
# PalStaminaDecreaceRate=1.000000
# PalAutoHPRegeneRate=1.000000
# PalAutoHpRegeneRateInSleep=1.000000

# ── Game Balance – Building and Resources ───────────────────
# BuildObjectDamageRate=1.000000
# BuildObjectDeteriorationDamageRate=1.000000
# CollectionDropRate=1.000000
# CollectionObjectHpRate=1.000000
# CollectionObjectRespawnSpeedRate=1.000000
# EnemyDropItemRate=1.000000
# ItemWeightRate=1.000000
# ItemCorruptionMultiplier=1.000000
# EquipmentDurabilityDamageRate=1.000000

# ── Game Balance – Death and Respawn ────────────────────────
# DeathPenalty: None / Item / ItemAndEquipment / All
# DeathPenalty=All
# bPalLost: Permanently lose Pals on death
# bPalLost=False
# PalEggDefaultHatchingTime: Hours to hatch a Huge Egg
# PalEggDefaultHatchingTime=72.000000
# BlockRespawnTime: Respawn cooldown in seconds
# BlockRespawnTime=0.000000
# RespawnPenaltyDurationThreshold=0.000000
# RespawnPenaltyTimeScale=1.000000
# SupplyDropSpan: Supply drop interval in minutes
# SupplyDropSpan=180
